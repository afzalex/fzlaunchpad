:80 {
    root * /usr/share/caddy

    # Enable gzip compression
    encode gzip

    # Set correct MIME types for JavaScript files (including service worker)
    @js {
        path *.js
    }
    header @js Content-Type "application/javascript; charset=utf-8"

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
    }

    # Handle requests for actual files (with extensions) - serve them directly, return 404 if not found
    @files {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot *.yaml *.yml *.json *.xml *.txt
    }
    handle @files {
        file_server
        # If file_server doesn't find the file, it will return 404 automatically
        # This handle block stops here and doesn't fall through
    }

    # Handle SPA routes (paths without file extensions) - fallback to index.html
    # This only matches paths that don't have file extensions
    @spa {
        not path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot *.yaml *.yml *.json *.xml *.txt *.html
    }
    handle @spa {
        rewrite * /index.html
        file_server
    }

    # Cache static assets for 1 year
    @static {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Don't cache HTML files
    @html {
        path *.html
    }
    header @html Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"

    # Don't cache config.yaml
    @config {
        path /config.yaml
    }
    header @config Cache-Control "no-store, no-cache, must-revalidate"
}

